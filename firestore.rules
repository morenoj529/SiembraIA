rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isCollaborator(colaboradores) {
      return isSignedIn() && request.auth.uid in colaboradores;
    }

    // ── users/{uid} ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false; // Prevent accidental account deletion
    }

    // ── farms/{farmId} ──────────────────────────────────────────────────────
    match /farms/{farmId} {
      allow read: if isSignedIn() &&
        (isOwner(resource.data.ownerId) ||
         isCollaborator(resource.data.colaboradores));
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId) ||
        isCollaborator(resource.data.colaboradores);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── plots/{plotId} ──────────────────────────────────────────────────────
    match /plots/{plotId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.ownerId) ||
        // Also allow collaborators of the parent farm
        exists(/databases/$(database)/documents/farms/$(resource.data.farmId)) &&
        isCollaborator(get(/databases/$(database)/documents/farms/$(resource.data.farmId)).data.colaboradores)
      );
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId);
      allow delete: if isOwner(resource.data.ownerId);
    }

    // ── visits/{visitId} ───────────────────────────────────────────────────
    match /visits/{visitId} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        // Owner of the plot can also read
        exists(/databases/$(database)/documents/plots/$(resource.data.plotId)) &&
        get(/databases/$(database)/documents/plots/$(resource.data.plotId)).data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    // ── photos/{photoId} ───────────────────────────────────────────────────
    match /photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
